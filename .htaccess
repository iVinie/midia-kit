# ==================================================================
# .htaccess DA RAIZ DO SITE
# Deixa seguro subir a pasta inteira: bloqueia arquivos internos que
# não fazem parte do site (documentação, git, configs). O site em si
# (index.html, css/, js/, imagens/) continua normal.
# ==================================================================

# --- Nunca exponha a pasta .git nem arquivos de ambiente ---
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env

# --- Bloqueia documentação e arquivos de config do projeto ---
<FilesMatch "\.(md|gitignore|gitattributes|bak|tmp|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Bloqueia o CLAUDE.md (contexto de dev, não é do site) ---
<Files "CLAUDE.md">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# --- js/dados.js é reescrito TODO DIA pelo RPA: não pode ficar em cache,
#     senão o visitante veria números velhos. O navegador revalida sempre. ---
<Files "dados.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</Files>
